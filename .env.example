# ──────────────────────────────────────────────
#  CEM Backend – variables de entorno requeridas
# ──────────────────────────────────────────────

# Servidor
NODE_ENV=development
PORT=8000

# Base de datos
DB_HOST=localhost
DB_PORT=3306
DB_NAME=CEM
DB_USER=root
DB_PASS=

# JWT
# Generar un valor seguro con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Mínimo 64 caracteres aleatorios. NUNCA usar 'secret123' ni valores predecibles.
JWT_SECRET=

# Google OAuth 2.0
# Obtener en: https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# URLs
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# MercadoPago
# Obtener en: https://www.mercadopago.com.ar/developers/panel
# Usar ACCESS TOKEN de prueba para sandbox
MERCADOPAGO_ACCESS_TOKEN=
# Clave secreta para validar firmas HMAC de webhooks.
# Obtener en: Panel MP → Tu integración → Webhooks → Clave secreta
# OBLIGATORIA en producción. Sin esta variable cualquiera puede forjar una notificación de pago.
MP_WEBHOOK_SECRET=

# Nodemailer
# Para Gmail: activar verificación en 2 pasos y generar una "Contraseña de aplicación"
# en: Cuenta de Google > Seguridad > Contraseñas de aplicaciones
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
